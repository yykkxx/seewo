build/
dist/
release/

# PyInstaller
*.spec
*.manifest

# Nuitka
*.build/
*.dist/
*.onefile-build/
*.pyi

# ==========================================================
#  Python
# ==========================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# 虚拟环境
.venv/
venv/
env/

# 打包 / 分发
*.egg-info/
.eggs/
wheels/

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/

# ==========================================================
